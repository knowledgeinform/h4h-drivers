#!/bin/bash

export CUDA_DIR=/usr/local/cuda/
export PATH=$CUDA_DIR/bin:/usr/src/tensorrt/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_DIR/lib64:/usr/lib/aarch64-linux-gnu2/tegra:$LD_LIBRARY_PATH
export C_INCLUDE_PATH=$CUDA_DIR/include:$C_INCLUDE_PATH
export CPLUS_INCLUDE_PATH=$CUDA_DIR/include:$CPLUS_INCLUDE_PATH

export XATR_ROOT=/opt/XATR
export LD_LIBRARY_PATH=$XATR_ROOT/lib:$LD_LIBRARY_PATH
export PATH=$XATR_ROOT/bin:$PATH
export C_INCLUDE_PATH=$XATR_ROOT/include:$C_INCLUDE_PATH
export CPLUS_INCLUDE_PATH=$XATR_ROOT/include:$CPLUS_INCLUDE_PATH

export PYTHONPATH=$PYTHONPATH:$XATR_ROOT/python_modules/:$XATR_ROOT/packages/Python/
