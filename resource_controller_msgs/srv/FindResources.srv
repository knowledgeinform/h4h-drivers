# The FindResources service takes in a list of resource names to find
# and returns a list of ResourceIdentifiers for each resource that was
# located. It also returns a list of bools indicating whether or not
# the resource was found.

# The list of resource names to find
string[] name
---

# The list of bools indicating whether each requested resource was found
# Note: response.found.size() == request.name.size()
bool[] found

# The list of ResourceIdentifiers for each requested resource
# Note: response.resource.size() == response.found.size() == request.name.size()
resource_controller_msgs/ResourceIdentifier[] resource