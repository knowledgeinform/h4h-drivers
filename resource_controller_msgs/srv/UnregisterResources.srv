# The UnregisterResources service is used by a ResourceController
# to notify the RobotResourceLocator that a set of resources should no
# longer be registered.

# The list of resource names that should be un-registered
string[] resource_name
---

# A list of bools indicating whether each of the resources was
# successfully un-registered with the resource locator or not.
# Note: response.success.size() == request.resource_name.size()
bool[] success