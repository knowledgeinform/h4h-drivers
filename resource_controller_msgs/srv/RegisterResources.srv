# The RegisterResources service is used by a ResourceController to notify
# the RobotResourceLocator of a set of resources managed by the resource controller.
#
# The service request provides:
#     - the topic for the service which determines if the resource
#       controller is still alive
#     - the list of ResourceIdentifiers for all resources managed
#       by the resource controller

# The topic for the service which determines if the resource
# controller is still alive
string is_alive_service_topic

# The list of ResourceIdentifiers for all resources managed
# by the resource controller
resource_controller_msgs/ResourceIdentifier[] resource
---

# A list of bools indicating whether each of the resources was
# successfully registered with the resource locator or not.
# Note: response.success.size() == request.resource.size()
bool[] success